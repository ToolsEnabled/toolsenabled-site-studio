{
  "name": "toolsenabled-site-studio",
  "version": "0.1.8",
  "description": "Build and edit static sites in an isolated working copy, with live preview and human-controlled export.",
  "author": {
    "name": "ToolsEnabled, Inc.",
    "email": "support@toolsenabled.ai",
    "url": "https://toolsenabled.ai"
  },
  "homepage": "https://toolsenabled.ai/site-studio/",
  "repository": "https://github.com/ToolsEnabled/toolsenabled-site-studio",
  "license": "MIT",
  "interface": {
    "displayName": "ToolsEnabled Site Studio",
    "shortDescription": "Local static website editing",
    "longDescription": "Connect an MCP host to a private working copy. Preview edits locally, checkpoint progress, and let the human undo or export.",
    "developerName": "ToolsEnabled, Inc.",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://toolsenabled.ai/site-studio/",
    "supportURL": "https://toolsenabled.ai/support/",
    "privacyPolicyURL": "https://toolsenabled.ai/privacy/",
    "defaultPrompt": [
      "Improve the sample site and show me a preview."
    ]
  },
  "mcpServers": {
    "site-studio": {
      "command": "node",
      "args": [
        "./mcp-web.js"
      ],
      "cwd": "./",
      "env_vars": [
        "SITE_STUDIO_ROOT",
        "SITE_STUDIO_DATA",
        "SystemRoot"
      ]
    }
  },
  "skills": "./skills/",
  "hooks": {}
}
