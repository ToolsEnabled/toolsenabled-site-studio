[
  {
    "name": "web_pages",
    "description": "List revision and files with up to 20 nodes each. Use file_id and node_offset for remaining nodes; offsets are revision-specific.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "File offset, default 0."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Files per page, default 20."
        },
        "file_id": {
          "type": "string",
          "description": "Optional file id to list its nodes.",
          "maxLength": 8192
        },
        "node_offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Node offset, default 0."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "title": "List pages and nodes",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "web_read",
    "description": "Read up to 16,384 characters of a managed HTML/CSS/text file, with revision and next offset. Opaque assets cannot be read.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "description": "File id from web_pages.",
          "maxLength": 8192
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive character offset."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Exclusive character offset."
        }
      },
      "required": [
        "file_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Read file source",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "web_find",
    "description": "Search text across all files in the current working copy (case-insensitive).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Non-empty text to find.",
          "maxLength": 8192
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum matches; default 40.",
          "maximum": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Find text",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "web_css",
    "description": "Read CSS rules whose selector contains the requested text, from the current working copy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "description": "Selector text, for example .hero.",
          "maxLength": 8192
        },
        "file_id": {
          "type": "string",
          "description": "Optional CSS file id.",
          "maxLength": 8192
        }
      },
      "required": [
        "selector"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Read CSS rules",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "web_set_text",
    "description": "Set the text of one paired HTML node. Pass expected_rev from your last read.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "description": "HTML file id.",
          "maxLength": 8192
        },
        "node_id": {
          "type": "string",
          "description": "Node id.",
          "maxLength": 8192
        },
        "text": {
          "type": "string",
          "description": "New plain text (escaped by Site Studio).",
          "maxLength": 8192
        },
        "expected_rev": {
          "type": "integer",
          "minimum": 0,
          "description": "Revision returned by your most recent read. Stale revisions refuse; read again."
        }
      },
      "required": [
        "file_id",
        "node_id",
        "text",
        "expected_rev"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Set node text",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
